# Server/CI only. Never prefix secrets with VITE_.
NVIDIA_API_KEY=
NVIDIA_MODEL_ID=
# Recommended Korean PoC model: nvidia/llama-nemotron-embed-1b-v2
NVIDIA_EMBEDDING_MODEL_ID=nvidia/llama-nemotron-embed-1b-v2
# auto, 2048, or 384 for the recommended multilingual model.
NVIDIA_EMBEDDING_DIMENSIONS=auto
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_MS=30000

# --- Visitor counter (Cloudflare Worker: workers/visitor.js) ---
# 배포 후 얻은 Workers URL. 랜딩·가이드·앱 세 화면이 모두 이 URL을 호출한다.
# 최초 배포: `cd workers && npx wrangler login && npx wrangler deploy` (workers/README.md 참조)
# 예) https://bible-mindmap-visitor.myaccount.workers.dev
VITE_VISITOR_API_URL=
