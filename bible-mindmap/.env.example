# Server/CI only. Never prefix secrets with VITE_.
NVIDIA_API_KEY=
NVIDIA_MODEL_ID=
# Recommended Korean PoC model: nvidia/llama-nemotron-embed-1b-v2
NVIDIA_EMBEDDING_MODEL_ID=nvidia/llama-nemotron-embed-1b-v2
# auto, 2048, or 384 for the recommended multilingual model.
NVIDIA_EMBEDDING_DIMENSIONS=auto
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_MS=30000

# --- Visitor counter (optional primary backend) ---
# 방문자 통계는 기본적으로 CounterAPI v2 public workspace 로 동작한다.
# 아래를 채우면 자체 Cloudflare Worker 를 1차로 사용하고, 실패 시 CounterAPI v2 로 자동 폴백.
# 최초 배포: workers/README.md 참조 (wrangler login → kv namespace create → deploy).
# 예) VITE_VISITOR_API_URL=https://bible-mindmap-visitor.myaccount.workers.dev
VITE_VISITOR_API_URL=
