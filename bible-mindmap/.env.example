# Server/CI only. Never prefix secrets with VITE_.
NVIDIA_API_KEY=
NVIDIA_MODEL_ID=
# Recommended Korean PoC model: nvidia/llama-nemotron-embed-1b-v2
NVIDIA_EMBEDDING_MODEL_ID=nvidia/llama-nemotron-embed-1b-v2
# auto, 2048, or 384 for the recommended multilingual model.
NVIDIA_EMBEDDING_DIMENSIONS=auto
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_MS=30000

# --- Visitor counter (api/visitor.mjs → Upstash Redis) ---
# Upstash 대시보드 > Redis DB > "REST API" 에서 복사.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Client-facing visitor API base URL ---
# 랜딩·가이드(GitHub Pages) 및 앱이 호출할 절대 URL.
# Vercel 프로덕션 URL로 지정 (예: https://bible-mindmap.vercel.app/api/visitor)
VITE_VISITOR_API_URL=https://bible-mindmap.vercel.app/api/visitor
