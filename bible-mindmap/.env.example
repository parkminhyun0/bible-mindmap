# Server/CI only. Never prefix secrets with VITE_.
NVIDIA_API_KEY=
NVIDIA_MODEL_ID=
# Recommended Korean PoC model: nvidia/llama-nemotron-embed-1b-v2
NVIDIA_EMBEDDING_MODEL_ID=nvidia/llama-nemotron-embed-1b-v2
# auto, 2048, or 384 for the recommended multilingual model.
NVIDIA_EMBEDDING_DIMENSIONS=auto
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_MS=30000
