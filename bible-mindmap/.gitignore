# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Local/server secrets
.env
.env.*
!.env.example

# Generated lexicon data (built by scripts/build-lexicon.mjs during CI)
public/data/*
# 지명 자동 색인은 커밋 대상 (build:places로 재생성 · CI 네트워크 비의존)
!public/data/places.json
# 정렬 데이터는 자비스 배치 산출물 · main 커밋 대상 (CDN 오프로드 아님, resolver 소비)
!public/data/alignment/
!public/data/alignment/**
# SBLGNT / OSHB XML 다운로드 캐시 (CI에서 재다운로드 · 로컬 반복 실행 가속)
.sblgnt-cache/
.oshb-cache/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Playwright artifacts
test-results/
playwright-report/

.claude/settings.local.json

# ── 음역 파이프라인 운용 산출물 ──────────────────────────────────────
# 여기 있는 것은 제품 코드가 아니라 병렬 작업을 굴리는 도구와 그 흔적이다.
# 일부만 추적되던 탓에 배치 PR 마다 "작업트리 오염" 경보가 반복됐고,
# 실제로 남의 미커밋 변경이 PR 에 딸려 들어가 CI 를 깨뜨린 적도 있다.
# 배치 산출물(.pipeline/taskNN)은 계속 추적한다 — 그것은 근거 자료다.
.pipeline/dispatch/
.pipeline/archive/
.pipeline/audit-full/
.pipeline/audit-verify/
.pipeline/gap-survey/
.pipeline/relay/
