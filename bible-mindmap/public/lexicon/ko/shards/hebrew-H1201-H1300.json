{"schemaVersion":1,"shardId":"hebrew-H1201-H1300","scope":{"kind":"language-strong-range","language":"hebrew","startStrong":"H1201","endStrong":"H1300"},"count":1,"entries":[{"identity":{"schemaVersion":1,"identityId":"H1254a","sourceForms":["H1254a"],"canonicalStrong":"H1254a","baseStrong":"H1254","disambiguationSuffix":"a","namespace":"extended-strong","testament":"old-testament","language":"hebrew","lemma":"בָּרָא","lemmaNormalized":"בָּרָא","transliteration":{"scientific":"bārāʾ","korean":"바라"},"partOfSpeech":{"code":"V","labelEn":"verb","labelKo":"동사"},"sourceRefs":[{"sourceId":"openscriptures-hebrewlexicon-bdb","locator":"BrownDriverBriggs.xml:b.cw.aa"}],"identityFingerprint":"sha256:3a0c2f682d8c894e3b2ac15e844e1036933b0d792312baf38f61bec51e98c635"},"approvedSenseTree":[{"id":"1","parentId":null,"depth":0,"order":1,"translationKo":"בָּרָא, 동사: 빚다, 만들다, 창조하다. 칼형에서는 빚다·형성하다·창조하다, 니팔형에서는 수동으로 창조되다와 새롭고 놀라운 것의 생겨남, 피엘형에서는 베어 쓰러뜨리다·베어내다를 뜻한다.","evidenceSupport":"direct"},{"id":"1.1","parentId":"1","depth":1,"order":2,"translationKo":"칼형: 빚다, 형성하다, 창조하다.","evidenceSupport":"direct"},{"id":"1.2","parentId":"1","depth":1,"order":3,"translationKo":"니팔형: 수동으로 창조되다. 새롭고 놀라운 것이 생겨나는 것과 관련된다.","evidenceSupport":"direct"},{"id":"1.2.1","parentId":"1.2","depth":2,"order":4,"translationKo":"창조되다.","evidenceSupport":"direct"},{"id":"1.2.2","parentId":"1.2","depth":2,"order":5,"translationKo":"생겨남 또는 출생과 관련하여.","evidenceSupport":"direct"},{"id":"1.2.3","parentId":"1.2","depth":2,"order":6,"translationKo":"새롭고 놀라운 어떤 것이 생겨나는 것.","evidenceSupport":"direct"},{"id":"1.3","parentId":"1","depth":1,"order":7,"translationKo":"피엘형: 베어 쓰러뜨리다, 베어내다.","evidenceSupport":"direct"},{"id":"1.3.1","parentId":"1.3","depth":2,"order":8,"translationKo":"베어 쓰러뜨리다.","evidenceSupport":"direct"},{"id":"1.3.2","parentId":"1.3","depth":2,"order":9,"translationKo":"베어내다.","evidenceSupport":"direct"}],"reviewer":{"reviewerId":"lexicon-v4-evidence-and-gate","reviewerType":"evidence-policy"},"approvedAt":"2