      "approvedSenseTree": [
        { "id": "1", "parentId": null, "depth": 0, "order": 1, "translationKo": "땅, 대지", "evidenceSupport": "direct" },
        { "id": "1.1", "parentId": "1", "depth": 1, "order": 2, "translationKo": "지구·땅", "evidenceSupport": "direct" },
        { "id": "1.1.1", "parentId": "1.1", "depth": 2, "order": 3, "translationKo": "한 부분과 대조되는 온 땅", "evidenceSupport": "direct" },
        { "id": "1.1.2", "parentId": "1.1", "depth": 2, "order": 4, "translationKo": "하늘과 대조되는 땅", "evidenceSupport": "direct" },
        { "id": "1.1.3", "parentId": "1.1", "depth": 2, "order": 5, "translationKo": "땅의 주민들", "evidenceSupport": "direct" },
        { "id": "1.2", "parentId": "1", "depth": 1, "order": 6, "translationKo": "지역·영토", "evidenceSupport": "direct" },
        { "id": "1.2.1", "parentId": "1.2", "depth": 2, "order": 7, "translationKo": "나라, 영토", "evidenceSupport": "direct" },
        { "id": "1.2.2", "parentId": "1.2", "depth": 2, "order": 8, "translationKo": "지방, 지역", "evidenceSupport": "direct" },
        { "id": "1.2.3", "parentId": "1.2", "depth": 2, "order": 9, "translationKo": "지파의 영토", "evidenceSupport": "direct" },
        { "id": "1.2.4", "parentId": "1.2", "depth": 2, "order": 10, "translationKo": "한 구획의 땅", "evidenceSupport": "direct" },
        { "id": "1.2.5", "parentId": "1.2", "depth": 2, "order": 11, "translationKo": "가나안 땅, 이스라엘 땅", "evidenceSupport": "direct" },
        { "id": "1.2.6", "parentId": "1.2", "depth": 2, "order": 12, "translationKo": "그 땅의 주민들", "evidenceSupport": "direct" },
        { "id": "1.2.7", "parentId": "1.2", "depth": 2, "order": 13, "translationKo": "스올, 돌아올 수 없는 땅, 지하 세계", "evidenceSupport": "direct" },
        { "id": "1.2.8", "parentId": "1.2", "depth": 2, "order": 14, "translationKo": "도시 또는 도시국가", "evidenceSupport": "legacy-only" },
        { "id": "1.3", "parentId": "1", "depth": 1, "order": 15, "translationKo": "땅바닥, 지표면", "evidenceSupport": "direct" },
        { "id": "1.3.1", "parentId": "1.3", "depth": 2, "order": 16, "translationKo": "땅바닥", "evidenceSupport": "direct" },
        { "id": "1.3.2", "parentId": "1.3", "depth": 2, "order": 17, "translationKo": "토양", "evidenceSupport": "direct" },
        { "id": "1.4", "parentId": "1", "depth": 1, "order": 18, "translationKo": "관용 표현에서의 용법", "evidenceSupport": "direct" },
        { "id": "1.4.1", "parentId": "1.4", "depth": 2, "order": 19, "translationKo": "그 땅의 백성", "evidenceSupport": "direct" },
        { "id": "1.4.2", "parentId": "1.4", "depth": 2, "order": 20, "translationKo": "거리 측정에서 사용되는 지역의 넓이 또는 거리", "evidenceSupport": "direct" },
        { "id": "1.4.3", "parentId": "1.4", "depth": 2, "order": 21, "translationKo": "평평한 지역, 평야 지대", "evidenceSupport": "direct" },
        { "id": "1.4.4", "parentId": "1.4", "depth": 2, "order": 22, "translationKo": "생존자의 땅", "evidenceSupport": "direct" },
        { "id": "1.4.5", "parentId": "1.4", "depth": 2, "order": 23, "translationKo": "땅끝", "evidenceSupport": "direct" },
        { "id": "1.5", "parentId": "1", "depth": 1, "order": 24, "translationKo": "거의 전적으로 후기 용례에서 사용됨", "evidenceSupport": "combined" },
        { "id": "1.5.1", "parentId": "1.5", "depth": 2, "order": 25, "translationKo": "여러 땅, 여러 나라", "evidenceSupport": "combined" },
        { "id": "1.5.1.1", "parentId": "1.5.1", "depth": 3, "order": 26, "translationKo": "종종 가나안과 대조되어 사용됨", "evidenceSupport": "combined" }
