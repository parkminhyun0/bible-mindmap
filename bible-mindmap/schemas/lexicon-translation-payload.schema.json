{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parkminhyun0.github.io/bible-mindmap/schemas/lexicon-translation-payload.schema.json",
  "title": "Bible Mindmap Lexicon Korean Translation Candidate",
  "description": "개혁주의 원어 사전 한글 번역 G1 공통 candidate payload 계약",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "strong",
    "language",
    "identity",
    "source",
    "sourceNodes",
    "drafts",
    "references",
    "adjudication",
    "theologyAudit",
    "quality",
    "status",
    "versions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^lexicon:(?:hebrew|aramaic|greek):[HG][1-9][0-9]*$" },
    "strong": { "type": "string", "pattern": "^[HG][1-9][0-9]*$" },
    "language": { "enum": ["hebrew", "aramaic", "greek"] },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lemma", "transliteration", "transliterationKo", "partOfSpeech"],
      "properties": {
        "lemma": { "type": ["string", "null"] },
        "transliteration": { "type": ["string", "null"] },
        "transliterationKo": { "type": ["string", "null"] },
        "partOfSpeech": { "type": ["string", "null"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lexicon", "version", "language", "licenseStatus", "sourceHash", "sourceRefs"],
      "properties": {
        "lexicon": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 2 },
        "licenseStatus": { "enum": ["verified-public-or-permitted", "internal-validation-only", "unknown", "prohibited"] },
        "sourceHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "sourceNodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "sourceHash"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "parentId": { "type": ["string", "null"] },
          "text": { "type": "string", "minLength": 1 },
          "sourceHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "drafts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nvidia", "gptBlind"],
      "properties": {
        "nvidia": { "$ref": "#/$defs/modelDraft" },
        "gptBlind": { "$ref": "#/$defs/modelDraft" }
      }
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["koreanDictionary", "bibleUsage", "reformedTerminology"],
      "properties": {
        "koreanDictionary": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "bibleUsage": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "reformedTerminology": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommendedNodes", "decision", "reason", "flags"],
      "properties": {
        "recommendedNodes": { "type": "array", "items": { "$ref": "#/$defs/translatedNode" } },
        "decision": { "enum": ["pending", "accept-nvidia", "accept-gpt", "synthesized", "retranslate", "review-required"] },
        "reason": { "type": ["string", "null"] },
        "flags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "theologyAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework", "riskTier", "result", "flags"],
      "properties": {
        "framework": { "const": "reformed-westminster-primary" },
        "riskTier": { "enum": ["R0", "R1", "R2", "R3", "R4", "unclassified"] },
        "result": { "enum": ["pending", "pass", "review-required", "blocked"] },
        "flags": {
          "type": "array",
          "items": {
            "enum": [
              "ETYMOLOGICAL_FALLACY",
              "DOCTRINAL_OVERREACH",
              "ANACHRONISTIC_READING",
              "NT_TO_OT_BACKPROJECTION",
              "OT_TO_NT_FLATTENING",
              "LEXICAL_THEOLOGY_CONFUSION",
              "CONTEXT_IGNORED",
              "CONFESSIONAL_TERM_MISMATCH",
              "MODERN_IDEOLOGICAL_PARAPHRASE",
              "UNSUPPORTED_CERTAINTY"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "sourceCoverage", "structurePreserved", "verifierPassed"],
      "properties": {
        "score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "sourceCoverage": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "structurePreserved": { "type": ["boolean", "null"] },
        "verifierPassed": { "type": ["boolean", "null"] }
      }
    },
    "status": {
      "enum": [
        "queued",
        "nvidia-draft",
        "gpt-blind-draft",
        "compared",
        "theology-audited",
        "machine-verified",
        "review-required",
        "expert-reviewed",
        "approved",
        "blocked"
      ]
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "policy", "translation", "modelRun"],
      "properties": {
        "contract": { "const": "2026.08.09-g1.1" },
        "policy": { "type": "string", "minLength": 1 },
        "translation": { "type": "string", "minLength": 1 },
        "modelRun": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "translatedNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "textKo", "confidence", "uncertainty"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "textKo": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "uncertainty": { "type": "array", "items": { "type": "string" } }
      }
    },
    "modelDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "promptVersion", "status", "nodes"],
      "properties": {
        "provider": { "enum": ["nvidia-build", "openai"] },
        "model": { "type": ["string", "null"] },
        "promptVersion": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pending", "complete", "failed", "blocked"] },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/translatedNode" } },
        "error": { "type": ["string", "null"] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "ref", "summary", "licenseUse"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "licenseUse": { "enum": ["display-allowed", "derived-terms-only", "internal-validation-only"] }
      }
    }
  }
}
