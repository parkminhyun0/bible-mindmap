{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parkminhyun0.github.io/bible-mindmap/schemas/lexicon/SourceDriverReport.schema.json",
  "title": "Bible Mind Map Lexicon Source Driver Report",
  "description": "Deterministic preflight or execution decision for a source-neutral lexicon parser driver.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportId",
    "driver",
    "requestId",
    "operation",
    "route",
    "selectedAdapterId",
    "source",
    "decision",
    "parserOutputFingerprint",
    "reportFingerprint"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reportId": { "type": "string", "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "policyVersion"],
      "properties": {
        "id": { "const": "lexicon-source-driver" },
        "version": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
        "policyVersion": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+$" }
      }
    },
    "requestId": { "type": "string", "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
    "operation": { "enum": ["preflight", "execute"] },
    "route": { "enum": ["legacy-adapter", "source-parser", "blocked"] },
    "selectedAdapterId": {
      "anyOf": [
        { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        { "type": "null" }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "registryWorkflowStatus",
        "registryAutoProcessingAllowed",
        "licenseStatus",
        "usagePolicy",
        "sourceFingerprint"
      ],
      "properties": {
        "sourceId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "registryWorkflowStatus": {
          "anyOf": [
            { "enum": ["approved-ready", "approved-pending-fingerprint", "internal-review-only", "metadata-only", "blocked"] },
            { "type": "null" }
          ]
        },
        "registryAutoProcessingAllowed": {
          "anyOf": [
            { "type": "boolean" },
            { "type": "null" }
          ]
        },
        "licenseStatus": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "usagePolicy": { "enum": ["automatic-evidence", "legacy-regression-only"] },
        "sourceFingerprint": {
          "anyOf": [
            { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            { "type": "null" }
          ]
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executionAllowed",
        "candidateGenerationAllowed",
        "candidateGenerationPolicy",
        "blockerCodes"
      ],
      "properties": {
        "executionAllowed": { "type": "boolean" },
        "candidateGenerationAllowed": { "type": "boolean" },
        "candidateGenerationPolicy": { "enum": ["disabled", "license-gated"] },
        "blockerCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
        }
      }
    },
    "parserOutputFingerprint": {
      "anyOf": [
        { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        { "type": "null" }
      ]
    },
    "reportFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
