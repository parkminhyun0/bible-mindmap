51","baseStrong":"H251","disambiguationSuffix":null,"namespace":"strong","testament":"old-testament","language":"hebrew","lemma":"אָח","lemmaNormalized":"אָח","transliteration":{"scientific":"ʾāḥ","korean":"아흐"},"partOfSpeech":{"code":"N","labelEn":"noun","labelKo":"명사"},"sourceRefs":[{"sourceId":"openscriptures-hebrewlexicon-bdb","locator":"BrownDriverBriggs.xml:a.ck.ab"}],"identityFingerprint":"sha256:df74d4209b96aba071a30c0a134dfbe9daee74dce5286fa2582930f370f67087"},"approvedSenseTree":[{"id":"1","parentId":null,"depth":0,"order":1,"translationKo":"אָח, 남성 명사: 형제, 남자 형제.","evidenceSupport":"direct"},{"id":"1.1","parentId":"1","depth":1,"order":2,"translationKo":"같은 어머니(및 아버지)에게서 난 형제.","evidenceSupport":"direct"},{"id":"1.2","parentId":"1","depth":1,"order":3,"translationKo":"넓게: 친족, 가까운 관계자.","evidenceSupport":"direct"},{"id":"1.3","parentId":"1","depth":1,"order":4,"translationKo":"비유적으로 닮음·유사 관계를 나타내는 용법.","evidenceSupport":"direct"},{"id":"1.4","parentId":"1","depth":1,"order":5,"translationKo":"'서로, 하나가 다른 하나에게'와 같은 상호 관계 표현에 쓰이는 용법.","evidenceSupport":"direct"}],"reviewer":{"reviewerId":"lexicon-v4-evidence-and-gate","reviewerType":"evidence-policy"},"approvedAt":"2026-08-12T10:19:42Z","evidencePacketFingerprint":"sha256:b3fcd9e4b0b84ba72bc7267a77876df4a8e6039f2b0a87ce60717a33bf45b71f"},{"identity":{"schemaVersion":1,"identityId":"H3117","sourceForms":["H3117"],"canonicalStrong":"H3117","baseStrong":"H3117","disambiguationSuffix":null,"namespace":"strong","testament":"old-testament","language":"hebrew","lemma":"יוֹם","lemmaNormalized":"יוֹם","transliteration":{"scientific":"yôm","korean":"욤"},"partOfSpeech":{"code":"N","labelEn":"noun","labelKo":"명사"},"sourceRefs":[{"sourceId":"openscriptures-hebrewlexicon-bdb","locator":"BrownDriverBriggs.xml:j.ay.aa"}],"identityFingerprint":"sha256:a94a0a567a744581828fcaca38f8e7e37c71f98d3dbeede19a5af5ebd9e7c8ac"},"approvedSenseTree":[{"id":"1","parentId":null,"depth":0,"order":1,"translationKo":"יוֹם, 남성 명사: 날. 밤과 대조되는 낮