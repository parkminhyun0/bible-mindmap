":"direct"},{"id":"1.1.1","parentId":"1.1","depth":2,"order":3,"translationKo":"낳다, 출산하다.","evidenceSupport":"direct"},{"id":"1.1.2","parentId":"1.1","depth":2,"order":4,"translationKo":"비교적 드물게: 자식을 낳다·두다(beget).","evidenceSupport":"direct"},{"id":"1.1.3","parentId":"1.1","depth":2,"order":5,"translationKo":"아버지와 어머니, 부모 양쪽을 주어로 하는 용례.","evidenceSupport":"direct"},{"id":"1.2","parentId":"1","depth":1,"order":6,"translationKo":"니팔(Niphal): 태어나다.","evidenceSupport":"direct"},{"id":"1.3","parentId":"1","depth":1,"order":7,"translationKo":"피엘(Piel): 출산하게 하거나 출산을 돕다, 곧 산파로 돕거나 돌보다.","evidenceSupport":"direct"},{"id":"1.4","parentId":"1","depth":1,"order":8,"translationKo":"푸알(Pual): 태어나다.","evidenceSupport":"direct"},{"id":"1.5","parentId":"1","depth":1,"order":9,"translationKo":"히필(Hiphil): 아버지가 자식을 낳다·두다(beget), 또는 낳다.","evidenceSupport":"direct"},{"id":"1.5.1","parentId":"1.5","depth":2,"order":10,"translationKo":"아버지가 자식을 낳다·두다(beget).","evidenceSupport":"direct"},{"id":"1.5.2","parentId":"1.5","depth":2,"order":11,"translationKo":"낳다.","evidenceSupport":"direct"},{"id":"1.6","parentId":"1","depth":1,"order":12,"translationKo":"호팔(Hophal): '자기가 태어난 날', 곧 생일을 나타내는 용례.","evidenceSupport":"direct"},{"id":"1.7","parentId":"1","depth":1,"order":13,"translationKo":"히트파엘(Hithpael): 자기 혈통·계보를 밝히거나 등록하다.","evidenceSupport":"direct"}],"reviewer":{"reviewerId":"lexicon-v4-evidence-and-gate","reviewerType":"evidence-policy"},"approvedAt":"2026-08-12T10:19:42Z","evidencePacketFingerprint":"sha256:f2f4bd68e880b4f2c07a839aba23e11769683c95fe91f7ffa5e4e788ec3469cd"},{"identity":{"schemaVersion":1,"identityId":"H3290","sourceForms":["H3290"],"canonicalStrong":"H3290","baseStrong":"H3290","disambiguationSuffix":null,"namespace":"strong","testament":"old-testament","language":"hebrew","lemma":"יַעֲקֹב","lemmaNormalized":"יַעֲקֹב","transliteration":{"scientific":"yaʿăqōb","korean":"야아코브"},"partOfSpeech":{"code":"Np","labelEn":"proper noun","labelKo":"고유명사"},"sourceRefs":[{"sourceId":"op