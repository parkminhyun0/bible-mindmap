{"schemaVersion":1,"shardId":"hebrew-H901-H1000","scope":{"kind":"language-strong-range","language":"hebrew","startStrong":"H901","endStrong":"H1000"},"count":1,"entries":[{"identity":{"schemaVersion":1,"identityId":"H935","sourceForms":["H935"],"canonicalStrong":"H935","baseStrong":"H935","disambiguationSuffix":null,"namespace":"strong","testament":"old-testament","language":"hebrew","lemma":"בּוֹא","lemmaNormalized":"בּוֹא","transliteration":{"scientific":"bôʾ","korean":"보"},"partOfSpeech":{"code":"V","labelEn":"verb","labelKo":"동사"},"sourceRefs":[{"sourceId":"openscriptures-hebrewlexicon-bdb","locator":"BrownDriverBriggs.xml:b.ap.aa"}],"identityFingerprint":"sha256:a7534a1acbe6b4b697349345bad8a6affbeedcd04636031a9a3ca35eafcb2c7b"},"approvedSenseTree":[{"id":"1","parentId":null,"depth":0,"order":1,"translationKo":"בּוֹא, 동사: 들어오다, 오다, 들어가다, 가다.","evidenceSupport":"direct"},{"id":"1.1","parentId":"1","depth":1,"order":2,"translationKo":"칼(Qal): 들어오다·오다(접근하다, 도착하다)·가다. 화자에게서 떠나는 경우에도 이동의 도착점이나 한계가 제시될 수 있다.","evidenceSupport":"direct"},{"id":"1.1.1","parentId":"1.1","depth":2,"order":3,"translationKo":"들어오다, 들어가다.","evidenceSupport":"direct"},{"id":"1.1.2","parentId":"1.1","depth":2,"order":4,"translationKo":"오다: 접근하다, 도착하다.","evidenceSupport":"direct"},{"id":"1.1.3","parentId":"1.1","depth":2,"order":5,"translationKo":"가다: 걷다, 함께 다니다.","evidenceSupport":"direct"},{"id":"1.1.4","parentId":"1.1","depth":2,"order":6,"translationKo":"화자에게서 떠나가되 이동의 도착점·한계가 제시되는 경우.","evidenceSupport":"direct"},{"id":"1.2","parentId":"1","depth":1,"order":7,"translationKo":"히필(Hiphil): 들어오게 하다·들여오다, 오게 하다·데려오다·가져오다·가까이 데려오다 등.","evidenceSupport":"direct"},{"id":"1.2.1","parentId":"1.2","depth":2,"order":8,"translationKo":"들어오게 하다, 들여오다: 사람이나 동물을 인도하여 데려오다.","evidenceSupport":"direct"},{"id":"1.2.2","parentId":"1.2","depth":2,"order":9,"translationKo":"오게 하다, 데려오다, 가져오다, 가까이 데려오다 등(생명 있는 목적어).","evidenceSupport":"direct"},{"id":"1.3","parentId":"1","depth":1,"order":10,"translationKo":"호팔(Hophal): 들어오게 되어 들어오다, 데려와지다·가져와지다, 소개되다·놓이다.","evidenceSupport":"direct"},{"id":"1.3.1","parentId":"1.3","depth":2,"order":11,"translationKo":"사람이나 사물이 들어오게 되어 들어오다.","evidenceSupport":"direct"},{"id":"1.3.2","parentId":"1.3","depth":2,"order":12,"translationKo":"데려와지다, 가져와지다.","evidenceSupport":"direct"},{"id":"1.3.3","parentId":"1.3","depth":2,"order":13,"translationKo":"소개되다, 놓이다.","evidenceSupport":"direct"}],"reviewer":{"reviewerId":"lexicon-v4-evidence-and-gate","reviewerType":"evidence-policy"},"approvedAt":"2026-08-12T10:19:42Z","evidencePacketFingerprint":"sha256:4ce5e3dab9619497cfde05a9edcbd8b39b69ab3ff7a903da075d50018873536c"}],"shardFingerprint":"sha256:e1b4c42a3ece5ef097d8f3aa089a9a3824da5778c701708760798f46fa1f1e08"}
