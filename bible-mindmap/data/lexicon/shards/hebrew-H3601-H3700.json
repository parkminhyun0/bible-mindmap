{"schemaVersion":1,"shardId":"hebrew-H3601-H3700","scope":{"kind":"language-strong-range","language":"hebrew","startStrong":"H3601","endStrong":"H3700"},"count":1,"entries":[{"identity":{"schemaVersion":1,"identityId":"H3605","sourceForms":["H3605"],"canonicalStrong":"H3605","baseStrong":"H3605","disambiguationSuffix":null,"namespace":"strong","testament":"old-testament","language":"hebrew","lemma":"כֹּל","lemmaNormalized":"כֹּל","transliteration":{"scientific":"kōl","korean":"콜"},"partOfSpeech":{"code":"N","labelEn":"noun","labelKo":"명사"},"sourceRefs":[{"sourceId":"openscriptures-hebrewlexicon-bdb","locator":"BrownDriverBriggs.xml:k.bn.ab"}],"identityFingerprint":"sha256:1c4ed7f08858f12635342cadb6a4af701c4962e0829dcb1881bebcbc29bb8688"},"approvedSenseTree":[{"id":"1","parentId":null,"depth":0,"order":1,"translationKo":"כֹּל, 남성 명사: 전체, 전부, 모든 것.","evidenceSupport":"direct"},{"id":"1.1","parentId":"1","depth":1,"order":2,"translationKo":"대개 뒤에 연계·속격 대상을 두어 '~의 전체'를 뜻하며, 문맥에 따라 한국어로 모든·각각·어떤 등으로 자연스럽게 옮긴다.","evidenceSupport":"direct"},{"id":"1.2","parentId":"1","depth":1,"order":3,"translationKo":"절대용법: 관사 없이 '모든 것·전부', 관사와 함께 הַכֹּל로 문맥이 한정한 전체 또는 더 넓은 전체를 가리킨다.","evidenceSupport":"direct"},{"id":"1.2.1","parentId":"1.2","depth":2,"order":4,"translationKo":"관사 없이: 모든 것, 전부.","evidenceSupport":"direct"},{"id":"1.2.2","parentId":"1.2","depth":2,"order":5,"translationKo":"관사와 함께 הַכֹּל: 문맥상 앞서 언급한 대상의 전체 또는 더 넓은 의미의 전체.","evidenceSupport":"direct"},{"id":"1.2.2.1","parentId":"1.2.2","depth":3,"order":6,"translationKo":"문맥에서 바로 앞서 언급한 사물이나 사람들로 범위가 제한되는 전체.","evidenceSupport":"direct"},{"id":"1.2.2.2","parentId":"1.2.2","depth":3,"order":7,"translationKo":"더 넓은 의미의 전체: 모든 인류·생물·우주 또는 삶의 모든 형편 등을 가리키는 용법(주로 후기 용례).","evidenceSupport":"direct"}],"reviewer":{"reviewerId":"lexicon-v4-evidence-and-gate","reviewerType":"evidence-policy"},"approvedAt":"2026-08-12T10:19:42Z","evidencePacketFingerprint":"sha256:7208cb2931aa45f09d1748f6136eb6efdeaef8c9b3fa0f1a2fccdb0ef872bca7"}],