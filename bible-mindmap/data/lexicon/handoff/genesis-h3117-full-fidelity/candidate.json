  "nodes": [
    {
      "sourceNodeId": "1",
      "textKo": "יוֹם, 남성 명사: 날. 밤과 대조되는 낮, 시간의 구분으로서의 날, 여호와의 날, 사람의 생애를 이루는 날들, 날들, 때, 여러 관용 표현에 쓰인다.",
      "confidence": 0.86,
      "riskFlags": [
        "polysemy",
        "theological-sensitive"
      ]
    },
    {
      "sourceNodeId": "1.1",
      "textKo": "밤과 대조되는 낮, 날.",
      "confidence": 0.89,
      "riskFlags": []
    },
    {
      "sourceNodeId": "1.2",
      "textKo": "시간을 나누는 단위로서의 날.",
      "confidence": 0.89,
      "riskFlags": []
    },
    {
      "sourceNodeId": "1.3",
      "textKo": "יוֹם י׳, 여호와의 날: 주로 그가 심판하러 오시는 때를 가리키며, 의인에게 복을 수반하는 경우가 많다.",
      "confidence": 0.86,
      "riskFlags": [
        "theological-sensitive"
      ]
    },
    {
      "sourceNodeId": "1.4",
      "textKo": "어떤 사람의 날들, 곧 그 사람에게 속한 생애의 날들.",
      "confidence": 0.89,
      "riskFlags": []
    },
    {
      "sourceNodeId": "1.5",
      "textKo": "날들.",
      "confidence": 0.89,
      "riskFlags": []
    },
    {
      "sourceNodeId": "1.6",
      "textKo": "יוֹם이 ‘때’를 뜻하는 용법.",
      "confidence": 0.89,
      "riskFlags": []
    },
    {
      "sourceNodeId": "1.7",
      "textKo": "여러 관용 표현.",
      "confidence": 0.89,
      "riskFlags": []
    }
